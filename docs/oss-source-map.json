{
  "repository": "crowsi-net/crowsi-transport-foundation",
  "purpose": "Bounded transport/framing plus owner-local single-use HTTP request control.",
  "responsibility_boundary": "Vendor APIs, effective IAM observation, native custody, filesystem isolation, product storage and retries are separate responsibilities.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "crowsi-transport-foundation",
      "ecosystem": "rust",
      "description": "Bounded local framing, delivery identities and transport lifecycle",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {
          "default": [],
          "async-io": [
            "dep:tokio"
          ],
          "process": [
            "dep:rustix"
          ],
          "http-contract": [
            "dep:bytes",
            "dep:http",
            "dep:serde",
            "dep:serde_json",
            "dep:tracing",
            "dep:zeroize",
            "dep:zstd"
          ],
          "loopback-http": [
            "async-io",
            "dep:httparse"
          ]
        },
        "bins": [],
        "public_modules": [
          "io",
          "http",
          "loopback_http",
          "process"
        ],
        "public_reexports": [],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/crowsi-authority-transport/Cargo.toml",
      "package": "crowsi-authority-transport",
      "ecosystem": "rust",
      "description": "Opaque signed envelopes over bounded mutually authenticated TLS",
      "interfaces": {
        "lib": "crates/crowsi-authority-transport/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "client::{AuthorityClient, ClientCredential}",
          "contract::{PeerBinding, RequestEnvelopeV1, ResponseEnvelopeV1, SignedRequest}",
          "error::TransportError",
          "server::{\n    AuthorityBackend, AuthorityServer, Clock, PeerStatusGuard, PeerStatusIdentity, ReplayGuard,\n    ServerCredential, SystemClock,\n}",
          "service_locator::{\n    SERVICE_LOCATOR_SCHEMA, ServiceLocatorV1, VerifiedServiceLocator,\n    service_locator_signing_bytes, verify_service_locator_at,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/crowsi-network-observer/Cargo.toml",
      "package": "crowsi-network-observer",
      "ecosystem": "rust",
      "description": "Safe, unprivileged network observation contracts for Crowsi",
      "interfaces": {
        "lib": "crates/crowsi-network-observer/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [
          "probes"
        ],
        "public_reexports": [
          "model::{\n    NetworkObservationInputV1, NetworkObservationV1, OBSERVATIONS_SCHEMA_V1, ObservationBatchV1,\n    ObservationStatusV1,\n}",
          "probe::{NetworkProbe, ProbeFailure, collect}",
          "time::{now_rfc3339, unix_millis_to_rfc3339}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "package.json",
      "package": "@crowsi/transport-foundation",
      "ecosystem": "npm",
      "description": null,
      "interfaces": {
        "exports": {
          ".": "./node/transport.mjs",
          "./process": "./node/process.mjs",
          "./realtime": "./node/realtime.mjs",
          "./state-socket": "./node/state-socket.mjs"
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs"
      }
    },
    {
      "manifest": "packages/crowsi-interaction-transport/package.json",
      "package": "@crowsi/interaction-transport",
      "ecosystem": "npm",
      "description": null,
      "interfaces": {
        "exports": {
          "./stdio": {
            "types": "./dist/stdio.d.mts",
            "import": "./dist/stdio.mjs"
          },
          "./client": {
            "types": "./dist/client.d.mts",
            "import": "./dist/client.mjs"
          },
          "./http": {
            "types": "./dist/http.d.mts",
            "import": "./dist/http.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "typecheck": "npm run build && tsc -p tsconfig.test.json",
        "build": "node scripts/clean-dist.mts && tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.mts",
        "prepack": "npm run typecheck && npm test"
      }
    },
    {
      "manifest": "packages/crowsi-provider-http-transport/package.json",
      "package": "@crowsi/provider-http-transport",
      "ecosystem": "npm",
      "description": "Bounded browser HTTP egress transport with explicit destination ownership",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
          },
          "./local-control": {
            "types": "./dist/local-control.d.mts",
            "import": "./dist/local-control.mjs"
          },
          "./execute-port": {
            "types": "./dist/execute-port.d.mts",
            "import": "./dist/execute-port.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "format": "biome format --write src test scripts",
        "format:check": "biome format src test scripts",
        "lint": "biome lint --error-on-warnings src test scripts",
        "typecheck": "tsc -p tsconfig.json",
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
        "test": "npm run build && node --test test/*.test.mjs",
        "check:lines": "node scripts/check-lines.mjs",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:lines",
        "prepack": "npm run check && npm test"
      }
    }
  ],
