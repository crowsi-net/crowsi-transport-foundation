{
  "name": "@crowsi/provider-http-transport",
  "version": "0.12.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Bounded browser HTTP egress transport with explicit destination ownership",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./local-control": {
      "types": "./dist/local-control.d.mts",
      "import": "./dist/local-control.mjs"
    },
    "./execute-port": {
      "types": "./dist/execute-port.d.mts",
      "import": "./dist/execute-port.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "README.ja.md",
    "docs"
  ],
  "scripts": {
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "lint": "biome lint --error-on-warnings src test scripts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:lines": "node scripts/check-lines.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:lines",
    "prepack": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crowsi-net/crowsi-transport-foundation.git",
    "directory": "packages/crowsi-provider-http-transport"
  },
  "packageManager": "npm@12.2.0",
  "homepage": "https://github.com/crowsi-net/crowsi-transport-foundation/tree/main/packages/crowsi-provider-http-transport",
  "bugs": {
    "url": "https://github.com/crowsi-net/crowsi-transport-foundation/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2"
  },
  "keywords": [
    "http",
    "bounded-io",
    "provider-integration",
    "typescript"
  ]
}
