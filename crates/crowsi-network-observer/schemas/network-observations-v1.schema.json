{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://network/observations/v1",
  "title": "Crowsi network observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "external_actions",
    "observation_count",
    "observations"
  ],
  "properties": {
    "schema": { "const": "crowsi://network/observations/v1" },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "external_actions": { "const": false },
    "observation_count": { "type": "integer", "minimum": 0 },
    "observations": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_id",
        "label",
        "zone",
        "protocol",
        "status",
        "observed_at",
        "latency_ms",
        "packet_loss_percent",
        "source",
        "finding_codes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "target_id": { "$ref": "#/$defs/identifier" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
        },
        "zone": { "$ref": "#/$defs/identifier" },
        "protocol": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": ["reachable", "observed", "degraded", "unavailable"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "latency_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "packet_loss_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "source": { "$ref": "#/$defs/identifier" },
        "finding_codes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    }
  }
}
